Windows Registry Editor Version 5.00

; ====================================================================
; SolidWorks COM 自动化接口注册表 (ProgID 与 CLSID 映射)
; 确保 Python win32com.client.DispatchEx("SldWorks.Application") 成功调用
; ====================================================================

; --- HKEY_CLASSES_ROOT ---
[HKEY_CLASSES_ROOT\SldWorks.Application]
@="SldWorks Application"

[HKEY_CLASSES_ROOT\SldWorks.Application\CLSID]
@="{6AF263BB-EB9F-4176-89E9-4F892EB0CA3D}"

[HKEY_CLASSES_ROOT\SldWorks.Application.33]
@="SldWorks 2025Application"

[HKEY_CLASSES_ROOT\SldWorks.Application.33\CLSID]
@="{6AF263BB-EB9F-4176-89E9-4F892EB0CA3D}"

[HKEY_CLASSES_ROOT\CLSID\{6AF263BB-EB9F-4176-89E9-4F892EB0CA3D}]
@="SldWorks 2025Application"

[HKEY_CLASSES_ROOT\CLSID\{6AF263BB-EB9F-4176-89E9-4F892EB0CA3D}\InprocHandler32]
@="ole32.dll"

[HKEY_CLASSES_ROOT\CLSID\{6AF263BB-EB9F-4176-89E9-4F892EB0CA3D}\LocalServer32]
@="\"C:\\Program Files\\SOLIDWORKS Corp\\SOLIDWORKS\\SLDWORKS.exe\""

[HKEY_CLASSES_ROOT\CLSID\{6AF263BB-EB9F-4176-89E9-4F892EB0CA3D}\ProgID]
@="SldWorks.Application.33"

[HKEY_CLASSES_ROOT\CLSID\{6AF263BB-EB9F-4176-89E9-4F892EB0CA3D}\VersionIndependentProgID]
@="SldWorks.Application"

[HKEY_CLASSES_ROOT\CLSID\{6AF263BB-EB9F-4176-89E9-4F892EB0CA3D}\TypeLib]
@="{83A33D31-27C5-11CE-BFD4-00400513BB57}"

