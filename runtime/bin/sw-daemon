#!/usr/bin/env bash
set -euo pipefail

SERVER_PY="${SERVER_PY:-/opt/sw-runtime/scripts/daemon_server.py}"

PID_FILE="${DAEMON_PID_FILE:-/tmp/sw-daemon.pid}"
VNC_PID_FILE="${DAEMON_VNC_PID_FILE:-/tmp/sw-daemon-vnc.pid}"
OPENBOX_PID_FILE="${DAEMON_OPENBOX_PID_FILE:-/tmp/sw-daemon-openbox.pid}"
LOG_FILE="${DAEMON_LOG_FILE:-/tmp/sw-daemon.log}"

DEFAULT_HOST="127.0.0.1"
DEFAULT_PORT="18282"
DEFAULT_TIMEOUT="45"
DEFAULT_VNC_PORT="5900"
DEFAULT_DISPLAY_RESOLUTION="1920x1080"

HOST="${SW_DAEMON_HOST:-${DEFAULT_HOST}}"
PORT="${SW_DAEMON_PORT:-${DEFAULT_PORT}}"
TIMEOUT_SEC="${SW_DAEMON_TIMEOUT:-${DEFAULT_TIMEOUT}}"

ENABLE_VNC=false
if [ "${VNC_ENABLE:-false}" = "true" ]; then
    ENABLE_VNC=true
fi

if [ "${VNC_INTERACTIVE:-false}" = "true" ]; then
    ENABLE_VNC=true
    VNC_INTERACTIVE=true
else
    VNC_INTERACTIVE=false
fi

VNC_PORT="${VNC_PORT:-${DEFAULT_VNC_PORT}}"
VNC_PASSWORD="${VNC_PASSWORD:-}"
DISPLAY_RESOLUTION="${DISPLAY_RESOLUTION:-${DEFAULT_DISPLAY_RESOLUTION}}"

VISIBLE=false
USER_CONTROL=false

DRY_RUN=false
COMMAND=""
POSITIONAL_ARGS=()

show_help() {
    cat <<EOF
DockerSW Daemon Management Tool (sw-daemon)

Usage:
  sw-daemon [options] <command> [command-options]

Commands:
  run                 Run the daemon server in foreground (ideal for Docker CMD / container PID 1)
  start               Start the background SolidWorks daemon server
  stop                Stop the running daemon server
  restart             Restart the daemon server
  status              Check daemon status and health

Options:
  --host HOST         Host address to bind (default: 127.0.0.1)
  --port PORT         Port to bind (default: 18282)
  --timeout SEC       Timeout in seconds waiting for daemon readiness (default: 45)
  --visible           Set SOLIDWORKS main window visible in X11 display
  --user-control      Grant human user full UI control in SolidWorks
  --vnc               Start VNC in view-only mode (-viewonly, default observation mode)
  --vnc-interactive   Start VNC in full interactive mode (allowing mouse/keyboard input)
  -p, --vnc-port PORT VNC port to bind (default: 5900)
  -P, --vnc-password PASS
                      Set VNC access password (default: none / passwordless)
  -r, --resolution WxH
                      Virtual display resolution (default: 1920x1080)
  --dry-run           Print execution plan and arguments without launching
  -h, --help          Show this help message

Environment Variables:
  SW_DAEMON_HOST          Daemon host (default: 127.0.0.1)
  SW_DAEMON_PORT          Daemon port (default: 18282)
  SW_DAEMON_TIMEOUT       Daemon ready timeout in seconds (default: 45)
  VNC_ENABLE              Set to 'true' to automatically enable VNC with daemon
  VNC_INTERACTIVE         Set to 'true' to allow mouse/keyboard input via VNC
  VNC_PORT                VNC port to bind (default: 5900)
  VNC_PASSWORD            VNC password (default: none / passwordless)
  DISPLAY_RESOLUTION      Virtual display resolution (default: 1920x1080)
EOF
}

# Parse options
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        --vnc)
            ENABLE_VNC=true
            VNC_INTERACTIVE=false
            shift
            ;;
        --vnc-interactive)
            ENABLE_VNC=true
            VNC_INTERACTIVE=true
            shift
            ;;
        -p|--vnc-port)
            VNC_PORT="$2"
            shift 2
            ;;
        -r|--resolution)
            DISPLAY_RESOLUTION="$2"
            shift 2
            ;;
        -P|--vnc-password)
            VNC_PASSWORD="$2"
            shift 2
            ;;
        --visible)
            VISIBLE=true
            shift
            ;;
        --user-control)
            USER_CONTROL=true
            shift
            ;;
        --port)
            PORT="$2"
            shift 2
            ;;
        --host)
            HOST="$2"
            shift 2
            ;;
        --timeout)
            TIMEOUT_SEC="$2"
            shift 2
            ;;
        run|start|stop|restart|status)
            if [ -z "${COMMAND}" ]; then
                COMMAND="$1"
            else
                POSITIONAL_ARGS+=("$1")
            fi
            shift
            ;;
        *)
            POSITIONAL_ARGS+=("$1")
            shift
            ;;
    esac
done

if [ -z "${COMMAND}" ]; then
    if [ ${#POSITIONAL_ARGS[@]} -gt 0 ]; then
        echo "Error: Unknown subcommand '${POSITIONAL_ARGS[0]}'" >&2
        show_help >&2
        exit 1
    else
        show_help
        exit 0
    fi
fi

is_process_alive() {
    local pid="$1"
    [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

query_health() {
    python3 -c "
import json, sys, urllib.request
try:
    req = urllib.request.Request('http://${HOST}:${PORT}/v1/health')
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    with opener.open(req, timeout=2) as resp:
        data = json.loads(resp.read().decode('utf-8'))
        sys.exit(0 if data.get('ready') else 1)
except Exception:
    sys.exit(2)
" 2>/dev/null
}

do_status() {
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid="$(cat "${PID_FILE}" 2>/dev/null || true)"
        if is_process_alive "${pid}"; then
            echo "[STATUS] DockerSW daemon is RUNNING (PID: ${pid})"
            if query_health; then
                echo "[HEALTH] SolidWorks COM connection: READY at http://${HOST}:${PORT}"
            else
                echo "[HEALTH] Daemon process alive, but COM server is NOT READY yet."
            fi
            return 0
        fi
    fi
    echo "[STATUS] DockerSW daemon is NOT RUNNING." >&2
    return 1
}

do_stop() {
    local stopped_anything=false
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid="$(cat "${PID_FILE}" 2>/dev/null || true)"
        if is_process_alive "${pid}"; then
            echo "[INFO] Stopping DockerSW daemon process (PID: ${pid})..."
            kill "${pid}" 2>/dev/null || true
            local count=0
            while is_process_alive "${pid}" && [ "${count}" -lt 10 ]; do
                sleep 0.5
                count=$((count + 1))
            done
            if is_process_alive "${pid}"; then
                kill -9 "${pid}" 2>/dev/null || true
            fi
            stopped_anything=true
        fi
        rm -f "${PID_FILE}"
    fi

    if [ -f "${VNC_PID_FILE}" ]; then
        local vnc_pid
        vnc_pid="$(cat "${VNC_PID_FILE}" 2>/dev/null || true)"
        if is_process_alive "${vnc_pid}"; then
            echo "[INFO] Stopping companion VNC process (PID: ${vnc_pid})..."
            kill "${vnc_pid}" 2>/dev/null || true
        fi
        rm -f "${VNC_PID_FILE}"
    fi

    if [ -f "${OPENBOX_PID_FILE}" ]; then
        local ob_pid
        ob_pid="$(cat "${OPENBOX_PID_FILE}" 2>/dev/null || true)"
        if is_process_alive "${ob_pid}"; then
            echo "[INFO] Stopping openbox window manager (PID: ${ob_pid})..."
            kill "${ob_pid}" 2>/dev/null || true
        fi
        rm -f "${OPENBOX_PID_FILE}"
    fi

    if [ "${stopped_anything}" = true ]; then
        echo "[OK] DockerSW daemon stopped."
    else
        echo "[INFO] No running daemon found."
    fi
    return 0
}

prepare_runtime() {
    local mode_desc="$1"
    VNC_ARGS=()
    if [ "${ENABLE_VNC}" = true ]; then
        VNC_ARGS+=("-display" ":99" "-rfbport" "${VNC_PORT}" "-forever" "-shared")
        if [ "${VNC_INTERACTIVE}" = false ]; then
            VNC_ARGS+=("-viewonly")
        fi
        if [ -n "${VNC_PASSWORD}" ]; then
            local vnc_dir="${HOME:-/root}/.vnc"
            mkdir -p "${vnc_dir}"
            x11vnc -storepasswd "${VNC_PASSWORD}" "${vnc_dir}/passwd" >/dev/null 2>&1 || true
            VNC_ARGS+=("-rfbauth" "${vnc_dir}/passwd")
        else
            VNC_ARGS+=("-nopw")
        fi
    fi

    VISIBLE_FLAG=""
    if [ "${ENABLE_VNC}" = true ] || [ "${VISIBLE:-false}" = "true" ]; then
        VISIBLE_FLAG="--visible"
        if [ "${VNC_INTERACTIVE}" = true ] || [ "${USER_CONTROL:-false}" = "true" ]; then
            VISIBLE_FLAG="--visible --user-control"
        fi
    fi

    if [ "${DRY_RUN}" = true ]; then
        echo "[DRY-RUN] Would ${mode_desc} on http://${HOST}:${PORT}"
        if [ "${ENABLE_VNC}" = true ]; then
            echo "[DRY-RUN] Screen resolution: ${DISPLAY_RESOLUTION}"
            echo "[DRY-RUN] Window manager: openbox"
            echo "[DRY-RUN] VNC command: x11vnc ${VNC_ARGS[*]}"
        fi
        echo "[DRY-RUN] Wine command: wine C:\\Python311\\python.exe Z:${SERVER_PY} --host ${HOST} --port ${PORT} ${VISIBLE_FLAG}"
        return 0
    fi

    # Ensure X11 display exists
    if [ ! -S "/tmp/.X11-unix/X99" ]; then
        Xvfb :99 -screen 0 "${DISPLAY_RESOLUTION}x24" -ac +extension GLX +render -noreset >/dev/null 2>&1 &
        for _ in {1..20}; do
            [ -S "/tmp/.X11-unix/X99" ] && break
            sleep 0.1
        done
    fi

    # Start companion openbox and VNC if requested
    if [ "${ENABLE_VNC}" = true ]; then
        openbox >/dev/null 2>&1 &
        echo "$!" > "${OPENBOX_PID_FILE}"

        x11vnc "${VNC_ARGS[@]}" -bg >/tmp/sw-vnc-daemon.log 2>&1 &
        echo "$!" > "${VNC_PID_FILE}"
        echo "[INFO] VNC server started on :${VNC_PORT} (resolution: ${DISPLAY_RESOLUTION}, interactive: ${VNC_INTERACTIVE})"

        echo "========================================================="
        echo "  DockerSW VNC 图形环境已就绪"
        echo "========================================================="
        echo "  - 屏幕分辨率: ${DISPLAY_RESOLUTION} (:99)"
        echo "  - VNC 端口:   ${VNC_PORT}"
        if [ -n "${VNC_PASSWORD}" ]; then
            echo "  - 访问密码:   [已设置]"
        else
            echo "  - 访问密码:   (无密码)"
        fi
        echo "  - Mac 快速连接: open vnc://<宿主机IP>:${VNC_PORT}"
        echo "========================================================="
    fi

    WIN_SERVER_PATH="Z:${SERVER_PY}"
    WIN_SERVER_PATH="${WIN_SERVER_PATH//\//\\}"
}

do_start() {
    if [ -f "${PID_FILE}" ]; then
        local existing_pid
        existing_pid="$(cat "${PID_FILE}" 2>/dev/null || true)"
        if is_process_alive "${existing_pid}"; then
            echo "[INFO] DockerSW daemon is already running (PID: ${existing_pid})."
            return 0
        fi
    fi

    prepare_runtime "start DockerSW daemon"
    if [ "${DRY_RUN}" = true ]; then
        return 0
    fi

    echo "[INFO] Launching DockerSW daemon on http://${HOST}:${PORT}..."
    wine "C:\\Python311\\python.exe" "${WIN_SERVER_PATH}" --host "${HOST}" --port "${PORT}" ${VISIBLE_FLAG} >"${LOG_FILE}" 2>&1 &

    local daemon_pid="$!"
    echo "${daemon_pid}" > "${PID_FILE}"

    # Poll until health endpoint is ready
    echo "[INFO] Waiting for daemon readiness (up to ${TIMEOUT_SEC}s)..."
    local elapsed=0
    while [ "${elapsed}" -lt "${TIMEOUT_SEC}" ]; do
        if ! is_process_alive "${daemon_pid}"; then
            echo "[FATAL] Daemon process terminated unexpectedly. Check ${LOG_FILE}" >&2
            rm -f "${PID_FILE}"
            return 1
        fi
        if query_health; then
            echo "[OK] DockerSW daemon is ready at http://${HOST}:${PORT}"
            return 0
        fi
        sleep 1
        elapsed=$((elapsed + 1))
    done

    echo "[FATAL] Timed out waiting for daemon to become ready." >&2
    return 1
}

do_run() {
    prepare_runtime "run DockerSW daemon in foreground"
    if [ "${DRY_RUN}" = true ]; then
        return 0
    fi

    cleanup() {
        echo "[INFO] Caught termination signal, stopping daemon and companion services..."
        do_stop >/dev/null 2>&1 || true
        exit 0
    }
    trap cleanup SIGTERM SIGINT SIGHUP

    echo "[INFO] Running DockerSW daemon in foreground on http://${HOST}:${PORT}..."
    wine "C:\\Python311\\python.exe" "${WIN_SERVER_PATH}" --host "${HOST}" --port "${PORT}" ${VISIBLE_FLAG} &

    local server_pid="$!"
    echo "${server_pid}" > "${PID_FILE}"
    wait "${server_pid}"
}

case "${COMMAND}" in
    run)
        do_run
        ;;
    start)
        do_start
        ;;
    stop)
        do_stop
        ;;
    restart)
        do_stop
        do_start
        ;;
    status)
        do_status
        ;;
    *)
        echo "Error: Unknown command '${COMMAND}'" >&2
        show_help >&2
        exit 1
        ;;
esac
