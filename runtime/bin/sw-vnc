#!/usr/bin/env bash
set -euo pipefail

# DockerSW VNC Graphical Workstation CLI (sw-vnc)
# sw-daemon 交互式图形桌面便捷别名。
# 默认以前台运行 (run) 方式拉起，并开启交互式 VNC 与 SOLIDWORKS 完整控制权。

SW_DAEMON_BIN="${SW_DAEMON_BIN:-sw-daemon}"

show_help() {
    cat << 'EOF'
DockerSW VNC 图形工作站便捷启动器 (sw-vnc)

用法:
  sw-vnc [选项] [daemon-command]

说明:
  本命令是 'sw-daemon --vnc-interactive' 的便捷别名。
  默认进入前台运行模式 (run)，自动拉起 Xvfb 虚拟屏幕、Openbox 窗口管理器与交互式 x11vnc，
  并赋予 SOLIDWORKS 完整的前台用户控制权 (UserControl=True, Visible=True)。

选项:
  -p, --port <port>          指定 VNC 监听端口 (默认: 5900，环境变量: VNC_PORT)
  -P, --password <pass>      设置 VNC 访问密码 (环境变量: VNC_PASSWORD)
  -r, --resolution <WxH>     设置虚拟屏幕分辨率 (默认: 1920x1080，环境变量: VNC_RESOLUTION)
      --dry-run              打印执行计划并安全退出
  -h, --help                 显示此帮助信息

环境变量:
  VNC_PORT                   VNC 服务端口 (默认: 5900)
  VNC_PASSWORD               VNC 访问密码
  VNC_RESOLUTION             虚拟屏幕分辨率 (默认: 1920x1080)

示例:
  sw-vnc                     # 默认拉起交互式 VNC 桌面并启动 SOLIDWORKS
  sw-vnc -p 5901 -P mypass   # 自定义端口与密码
  sw-vnc -r 2560x1440        # 2K 高分屏启动
  sw-vnc status              # 查看 VNC/daemon 运行状态
  sw-vnc stop                # 停止图形工作站及后台守护
EOF
}

CLI_VNC_PORT=""
CLI_VNC_RES=""
CLI_VNC_PASS=""
DRY_RUN=false
HAS_COMMAND=false
PASSTHROUGH_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        -p|--port)
            [[ $# -ge 2 ]] || { echo "[ERROR] --port 需要一个参数" >&2; exit 1; }
            CLI_VNC_PORT="$2"
            shift 2
            ;;
        -P|--password)
            [[ $# -ge 2 ]] || { echo "[ERROR] --password 需要一个参数" >&2; exit 1; }
            CLI_VNC_PASS="$2"
            shift 2
            ;;
        -r|--resolution)
            [[ $# -ge 2 ]] || { echo "[ERROR] --resolution 需要一个参数" >&2; exit 1; }
            CLI_VNC_RES="$2"
            shift 2
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        run|start|stop|restart|status)
            HAS_COMMAND=true
            PASSTHROUGH_ARGS+=("$1")
            shift
            ;;
        -*)
            echo "[ERROR] 未知选项: $1" >&2
            echo "请运行 'sw-vnc --help' 查看可用选项" >&2
            exit 1
            ;;
        *)
            PASSTHROUGH_ARGS+=("$1")
            shift
            ;;
    esac
done

DAEMON_ARGS=("--vnc-interactive")
[ -n "${CLI_VNC_PORT}" ] && DAEMON_ARGS+=("-p" "${CLI_VNC_PORT}")
[ -n "${CLI_VNC_RES}" ] && DAEMON_ARGS+=("-r" "${CLI_VNC_RES}")
[ -n "${CLI_VNC_PASS}" ] && DAEMON_ARGS+=("-P" "${CLI_VNC_PASS}")
[ "${DRY_RUN}" = true ] && DAEMON_ARGS+=("--dry-run")

# 未显式指定 daemon 命令时，默认以前台交互模式 (run) 启动
if [ "${HAS_COMMAND}" = false ]; then
    DAEMON_ARGS+=("run")
fi

exec "${SW_DAEMON_BIN}" "${DAEMON_ARGS[@]}" ${PASSTHROUGH_ARGS[@]+"${PASSTHROUGH_ARGS[@]}"}
