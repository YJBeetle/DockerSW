#!/usr/bin/env bash
set -euo pipefail

# Docker-specific path and daemon lifecycle adapter around SWCLI's export utility.
WIN_PYTHON="${SWCLI_WINDOWS_PYTHON:-C:\\Python311\\python.exe}"
ARGS=("$@")
SWCLID_HELPER="${SWCLID_HELPER:-/opt/sw-runtime/scripts/lib/swclid.sh}"
if [ ! -f "${SWCLID_HELPER}" ]; then
    SWCLID_HELPER="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../scripts/lib/swclid.sh"
fi
# shellcheck source=../scripts/lib/swclid.sh
source "${SWCLID_HELPER}"
swclid_configure

to_windows_path() {
    local value="$1"
    if [[ "${value}" =~ ^[A-Za-z]:[\\/].* ]]; then
        printf '%s\n' "${value}"
    else
        winepath -w -- "${value}"
    fi
}

for ((index = 0; index < ${#ARGS[@]}; index++)); do
    case "${ARGS[${index}]}" in
        --list|--workspace|--outdir)
            next=$((index + 1))
            if [ "${#ARGS[@]}" -le "${next}" ]; then
                echo "sw-export: ${ARGS[${index}]} requires a path" >&2
                exit 2
            fi
            ARGS[${next}]="$(to_windows_path "${ARGS[${next}]}")"
            index="${next}"
            ;;
    esac
done

for argument in "${ARGS[@]}"; do
    if [ "${argument}" = "--help" ] || [ "${argument}" = "-h" ]; then
        exec wine "${WIN_PYTHON}" -m swcli.utils.export "${ARGS[@]}"
    fi
done

swclid_ensure
exec wine "${WIN_PYTHON}" -m swcli.utils.export "${ARGS[@]}"
