#!/usr/bin/env bash
set -euo pipefail

# Docker-specific lifecycle adapter around SWCLI's typed batch workflow.
WIN_PYTHON="${SWCLI_WINDOWS_PYTHON:-C:\\Python311\\python.exe}"
RUNNER="${SWCLI_EXPORT_RUNNER:-/opt/sw-runtime/scripts/swcli_docker_export.py}"
ARGS=("$@")

to_windows_path() {
    local value="$1"
    if [[ "${value}" =~ ^[A-Za-z]:[\\/].* ]]; then
        printf '%s\n' "${value}"
    else
        winepath -w -- "${value}"
    fi
}

for ((index = 0; index < ${#ARGS[@]}; index++)); do
    case "${ARGS[${index}]}" in
        --list|--workspace|--outdir)
            next=$((index + 1))
            if [ "${#ARGS[@]}" -le "${next}" ]; then
                echo "sw-export: ${ARGS[${index}]} requires a path" >&2
                exit 2
            fi
            ARGS[${next}]="$(to_windows_path "${ARGS[${next}]}")"
            index="${next}"
            ;;
    esac
done

WIN_RUNNER="$(to_windows_path "${RUNNER}")"
exec wine "${WIN_PYTHON}" "${WIN_RUNNER}" "${ARGS[@]}"
