#!/usr/bin/env bash
set -euo pipefail

# The protocol client runs in Linux Python. Local host diagnostics and daemon
# lifecycle commands run in the Wine Windows Python environment.
WIN_PYTHON="${SWCLI_WINDOWS_PYTHON:-C:\\Python311\\python.exe}"
ARGS=("$@")
SWCLI_SOURCE="${SWCLI_SOURCE:-/opt/swcli/src}"
SWCLI_ENDPOINT="${SWCLI_ENDPOINT:-127.0.0.1:18495}"
PYTHONPATH="${SWCLI_SOURCE}${PYTHONPATH:+:${PYTHONPATH}}"
export PYTHONPATH SWCLI_ENDPOINT

to_windows_path() {
    local value="$1"
    if [[ "${value}" =~ ^[A-Za-z]:[\\/].* ]]; then
        printf '%s\n' "${value}"
    else
        winepath -w -- "${value}"
    fi
}

translate_positional_path() {
    local index="$1"
    if [ "${#ARGS[@]}" -gt "${index}" ]; then
        ARGS[${index}]="$(to_windows_path "${ARGS[${index}]}")"
    fi
}

if [ "${#ARGS[@]}" -ge 2 ]; then
    case "${ARGS[0]} ${ARGS[1]}" in
        "document open"|"document render"|"document export"|"part create-box")
            translate_positional_path 2
            ;;
    esac
fi

if [ "${#ARGS[@]}" -ge 2 ] && [ "${ARGS[0]} ${ARGS[1]}" = "daemon serve" ]; then
    has_host_platform=false
    for argument in "${ARGS[@]}"; do
        if [ "${argument}" = "--host-platform" ]; then
            has_host_platform=true
            break
        fi
    done
    if [ "${has_host_platform}" = false ]; then
        ARGS=("daemon" "serve" "--host-platform" "linux-wine" "${ARGS[@]:2}")
    fi
fi

if [ "${#ARGS[@]}" -gt 0 ] && \
   { [ "${ARGS[0]}" = "doctor" ] || [ "${ARGS[0]}" = "daemon" ]; }; then
    exec wine "${WIN_PYTHON}" -m swcli "${ARGS[@]}"
fi

exec python3 -m swcli "${ARGS[@]}"
