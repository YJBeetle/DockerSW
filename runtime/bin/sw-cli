#!/usr/bin/env bash
set -euo pipefail

# The protocol client runs in Linux Python; host diagnostics and daemon
# lifecycle commands run in the Wine Windows Python environment. This wrapper
# only routes commands and sets the container environment. Typed file-path
# arguments stay in their Linux form here and are translated to Wine paths by
# the sw-cli client itself through SWCLI_PATH_TRANSLATE_CMD, so this wrapper
# never needs to know which arguments are paths.
WIN_PYTHON="${SWCLI_WINDOWS_PYTHON:-C:\\Python311\\python.exe}"
SWCLI_SOURCE="${SWCLI_SOURCE:-/opt/swcli/src}"
SWCLI_ENDPOINT="${SWCLI_ENDPOINT:-127.0.0.1:18495}"
export PYTHONPATH="${SWCLI_SOURCE}${PYTHONPATH:+:${PYTHONPATH}}"
export SWCLI_ENDPOINT
export SWCLI_PATH_TRANSLATE_CMD=/usr/local/bin/linux-to-wine-path

ARGS=("$@")

if [ "${#ARGS[@]}" -ge 2 ] && [ "${ARGS[0]} ${ARGS[1]}" = "daemon serve" ] && \
   [[ " ${ARGS[*]} " != *" --host-platform "* ]]; then
    ARGS=("daemon" "serve" "--host-platform" "linux-wine" "${ARGS[@]:2}")
fi

if [ "${#ARGS[@]}" -ge 1 ] && \
   { [ "${ARGS[0]}" = "doctor" ] || [ "${ARGS[0]}" = "daemon" ]; }; then
    exec wine "${WIN_PYTHON}" -m swcli "${ARGS[@]}"
fi

exec python3 -m swcli "${ARGS[@]}"
