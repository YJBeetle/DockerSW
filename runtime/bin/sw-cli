#!/usr/bin/env bash
set -euo pipefail

# DockerSW only adapts Linux container paths/processes. The actual CLI runs in
# the Wine Windows Python environment where SOLIDWORKS COM is registered.
WIN_PYTHON="${SWCLI_WINDOWS_PYTHON:-C:\\Python311\\python.exe}"
ARGS=("$@")
SWCLID_HELPER="${SWCLID_HELPER:-/opt/sw-runtime/scripts/lib/swclid.sh}"
if [ ! -f "${SWCLID_HELPER}" ]; then
    SWCLID_HELPER="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../scripts/lib/swclid.sh"
fi
# shellcheck source=../scripts/lib/swclid.sh
source "${SWCLID_HELPER}"
swclid_configure

to_windows_path() {
    local value="$1"
    if [[ "${value}" =~ ^[A-Za-z]:[\\/].* ]]; then
        printf '%s\n' "${value}"
    else
        winepath -w -- "${value}"
    fi
}

translate_positional_path() {
    local index="$1"
    if [ "${#ARGS[@]}" -gt "${index}" ]; then
        ARGS[${index}]="$(to_windows_path "${ARGS[${index}]}")"
    fi
}

if [ "${#ARGS[@]}" -ge 2 ]; then
    case "${ARGS[0]} ${ARGS[1]}" in
        "document open"|"document render"|"document export"|"part create-box")
            translate_positional_path 2
            ;;
        "batch export")
            for ((index = 2; index < ${#ARGS[@]}; index++)); do
                case "${ARGS[${index}]}" in
                    --list|--workspace|--outdir)
                        next=$((index + 1))
                        if [ "${#ARGS[@]}" -le "${next}" ]; then
                            echo "sw-cli: ${ARGS[${index}]} requires a path" >&2
                            exit 2
                        fi
                        ARGS[${next}]="$(to_windows_path "${ARGS[${next}]}")"
                        index="${next}"
                        ;;
                esac
            done
            ;;
    esac
fi

if [ "${#ARGS[@]}" -gt 0 ]; then
    case "${ARGS[0]}" in
        document|part|batch)
            swclid_ensure
            ;;
    esac
fi

exec wine "${WIN_PYTHON}" -m swcli "${ARGS[@]}"
