#!/usr/bin/env bash
set -euo pipefail

# The protocol client runs in Linux Python. Only explicit host diagnostics and
# swclid's COM worker run in the Wine Windows Python environment.
WIN_PYTHON="${SWCLI_WINDOWS_PYTHON:-C:\\Python311\\python.exe}"
ARGS=("$@")
SWCLI_SOURCE="${SWCLI_SOURCE:-/opt/swcli/src}"
SWCLI_ENDPOINT="${SWCLI_ENDPOINT:-127.0.0.1:18495}"
SWCLID_COMMAND="${SWCLID_COMMAND:-$(dirname "${BASH_SOURCE[0]}")/swclid}"
PYTHONPATH="${SWCLI_SOURCE}${PYTHONPATH:+:${PYTHONPATH}}"
export PYTHONPATH SWCLI_ENDPOINT

to_windows_path() {
    local value="$1"
    if [[ "${value}" =~ ^[A-Za-z]:[\\/].* ]]; then
        printf '%s\n' "${value}"
    else
        winepath -w -- "${value}"
    fi
}

translate_positional_path() {
    local index="$1"
    if [ "${#ARGS[@]}" -gt "${index}" ]; then
        ARGS[${index}]="$(to_windows_path "${ARGS[${index}]}")"
    fi
}

if [ "${#ARGS[@]}" -ge 2 ]; then
    case "${ARGS[0]} ${ARGS[1]}" in
        "document open"|"document render"|"document export"|"part create-box")
            translate_positional_path 2
            ;;
    esac
fi

if [ "${#ARGS[@]}" -gt 0 ]; then
    case "${ARGS[0]}" in
        document|part)
            "${SWCLID_COMMAND}" start
            ;;
    esac
fi

if [ "${#ARGS[@]}" -gt 0 ] && [ "${ARGS[0]}" = "host" ]; then
    exec wine "${WIN_PYTHON}" -m swcli "${ARGS[@]}"
fi

exec python3 -m swcli "${ARGS[@]}"
