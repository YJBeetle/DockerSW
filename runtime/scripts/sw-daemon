#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SERVER_PY="${SCRIPT_DIR}/daemon_server.py"

PID_FILE="${SW_DAEMON_PID_FILE:-/tmp/sw-daemon.pid}"
VNC_PID_FILE="${SW_DAEMON_VNC_PID_FILE:-/tmp/sw-daemon-vnc.pid}"
LOG_FILE="${SW_DAEMON_LOG_FILE:-/tmp/sw-daemon.log}"

DEFAULT_HOST="127.0.0.1"
DEFAULT_PORT="18282"
DEFAULT_TIMEOUT="45"

HOST="${SW_DAEMON_HOST:-${DEFAULT_HOST}}"
PORT="${SW_DAEMON_PORT:-${DEFAULT_PORT}}"
TIMEOUT_SEC="${SW_DAEMON_TIMEOUT:-${DEFAULT_TIMEOUT}}"

ENABLE_VNC=false
VNC_INTERACTIVE=false
DRY_RUN=false
COMMAND=""
POSITIONAL_ARGS=()

show_help() {
    cat <<EOF
DockerSW Daemon Management Tool (sw-daemon)

Usage:
  sw-daemon [options] <command> [command-options]

Commands:
  start               Start the background SolidWorks daemon server
  stop                Stop the running daemon server
  restart             Restart the daemon server
  status              Check daemon status and health

Options:
  --vnc               Start VNC in view-only mode (-viewonly, default observation mode)
  --vnc-interactive   Start VNC in full interactive mode (allowing mouse/keyboard input)
  --port PORT         Port to bind (default: 18282)
  --host HOST         Host address to bind (default: 127.0.0.1)
  --timeout SEC       Timeout in seconds waiting for daemon readiness (default: 45)
  --dry-run           Print execution plan and arguments without launching
  -h, --help          Show this help message

Environment Variables:
  SW_DAEMON_HOST          Daemon host (default: 127.0.0.1)
  SW_DAEMON_PORT          Daemon port (default: 18282)
  SW_DAEMON_PID_FILE      Path to PID file (default: /tmp/sw-daemon.pid)
EOF
}

# Parse options
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        --vnc)
            ENABLE_VNC=true
            VNC_INTERACTIVE=false
            shift
            ;;
        --vnc-interactive)
            ENABLE_VNC=true
            VNC_INTERACTIVE=true
            shift
            ;;
        --port)
            PORT="$2"
            shift 2
            ;;
        --host)
            HOST="$2"
            shift 2
            ;;
        --timeout)
            TIMEOUT_SEC="$2"
            shift 2
            ;;
        start|stop|restart|status)
            if [ -z "${COMMAND}" ]; then
                COMMAND="$1"
            else
                POSITIONAL_ARGS+=("$1")
            fi
            shift
            ;;
        *)
            POSITIONAL_ARGS+=("$1")
            shift
            ;;
    esac
done

if [ -z "${COMMAND}" ]; then
    if [ ${#POSITIONAL_ARGS[@]} -gt 0 ]; then
        echo "Error: Unknown subcommand '${POSITIONAL_ARGS[0]}'" >&2
        show_help >&2
        exit 1
    else
        show_help
        exit 0
    fi
fi

is_process_alive() {
    local pid="$1"
    [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

query_health() {
    python3 -c "
import json, sys, urllib.request
try:
    req = urllib.request.Request('http://${HOST}:${PORT}/v1/health')
    with urllib.request.urlopen(req, timeout=2) as resp:
        data = json.loads(resp.read().decode('utf-8'))
        sys.exit(0 if data.get('ready') else 1)
except Exception:
    sys.exit(2)
" 2>/dev/null
}

do_status() {
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid="$(cat "${PID_FILE}" 2>/dev/null || true)"
        if is_process_alive "${pid}"; then
            echo "[STATUS] DockerSW daemon is RUNNING (PID: ${pid})"
            if query_health; then
                echo "[HEALTH] SolidWorks COM connection: READY at http://${HOST}:${PORT}"
            else
                echo "[HEALTH] Daemon process alive, but COM server is NOT READY yet."
            fi
            return 0
        fi
    fi
    echo "[STATUS] DockerSW daemon is NOT RUNNING." >&2
    return 1
}

do_stop() {
    local stopped_anything=false
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid="$(cat "${PID_FILE}" 2>/dev/null || true)"
        if is_process_alive "${pid}"; then
            echo "[INFO] Stopping DockerSW daemon process (PID: ${pid})..."
            kill "${pid}" 2>/dev/null || true
            local count=0
            while is_process_alive "${pid}" && [ "${count}" -lt 10 ]; do
                sleep 0.5
                count=$((count + 1))
            done
            if is_process_alive "${pid}"; then
                kill -9 "${pid}" 2>/dev/null || true
            fi
            stopped_anything=true
        fi
        rm -f "${PID_FILE}"
    fi

    if [ -f "${VNC_PID_FILE}" ]; then
        local vnc_pid
        vnc_pid="$(cat "${VNC_PID_FILE}" 2>/dev/null || true)"
        if is_process_alive "${vnc_pid}"; then
            echo "[INFO] Stopping companion VNC process (PID: ${vnc_pid})..."
            kill "${vnc_pid}" 2>/dev/null || true
        fi
        rm -f "${VNC_PID_FILE}"
    fi

    if [ "${stopped_anything}" = true ]; then
        echo "[OK] DockerSW daemon stopped."
    else
        echo "[INFO] No running daemon found."
    fi
    return 0
}

do_start() {
    if [ -f "${PID_FILE}" ]; then
        local existing_pid
        existing_pid="$(cat "${PID_FILE}" 2>/dev/null || true)"
        if is_process_alive "${existing_pid}"; then
            echo "[INFO] DockerSW daemon is already running (PID: ${existing_pid})."
            return 0
        fi
    fi

    local vnc_args=()
    if [ "${ENABLE_VNC}" = true ]; then
        vnc_args+=("-display" ":99" "-rfbport" "5900" "-forever" "-shared")
        if [ "${VNC_INTERACTIVE}" = false ]; then
            vnc_args+=("-viewonly")
        fi
    fi

    local visible_flag=""
    if [ "${ENABLE_VNC}" = true ]; then
        visible_flag="--visible"
    fi

    if [ "${DRY_RUN}" = true ]; then
        echo "[DRY-RUN] Would start DockerSW daemon on http://${HOST}:${PORT}"
        if [ "${ENABLE_VNC}" = true ]; then
            echo "[DRY-RUN] VNC command: x11vnc ${vnc_args[*]}"
        fi
        echo "[DRY-RUN] Wine command: wine C:\\Python311\\python.exe Z:${SERVER_PY} --host ${HOST} --port ${PORT} ${visible_flag}"
        return 0
    fi

    # Ensure X11 display exists
    if [ ! -S "/tmp/.X11-unix/X99" ]; then
        if [ -x "/usr/local/bin/entrypoint.sh" ]; then
            /usr/local/bin/entrypoint.sh --init-only >/dev/null 2>&1 || true
        elif command -v Xvfb >/dev/null 2>&1; then
            Xvfb :99 -screen 0 1920x1080x24 >/dev/null 2>&1 &
            sleep 0.5
        fi
    fi

    # Start companion VNC if requested
    if [ "${ENABLE_VNC}" = true ]; then
        if command -v x11vnc >/dev/null 2>&1; then
            x11vnc "${vnc_args[@]}" -bg -nopw >/tmp/sw-vnc-daemon.log 2>&1 &
            echo "$!" > "${VNC_PID_FILE}"
            echo "[INFO] VNC server started on :5900 (interactive: ${VNC_INTERACTIVE})"
        else
            echo "[WARN] x11vnc not installed; continuing without VNC." >&2
        fi
    fi

    # Start Wine daemon server
    local python_bin="python3"
    local win_server_path="${SERVER_PY}"
    if command -v wine >/dev/null 2>&1; then
        python_bin="wine"
        win_server_path="Z:${SERVER_PY}"
        win_server_path="${win_server_path//\//\\}"
    fi

    echo "[INFO] Launching DockerSW daemon on http://${HOST}:${PORT}..."
    if [ "${python_bin}" = "wine" ]; then
        wine "C:\\Python311\\python.exe" "${win_server_path}" --host "${HOST}" --port "${PORT}" ${visible_flag} >"${LOG_FILE}" 2>&1 &
    else
        python3 "${SERVER_PY}" --host "${HOST}" --port "${PORT}" ${visible_flag} >"${LOG_FILE}" 2>&1 &
    fi

    local daemon_pid="$!"
    echo "${daemon_pid}" > "${PID_FILE}"

    # Poll until health endpoint is ready
    echo "[INFO] Waiting for daemon readiness (up to ${TIMEOUT_SEC}s)..."
    local elapsed=0
    while [ "${elapsed}" -lt "${TIMEOUT_SEC}" ]; do
        if ! is_process_alive "${daemon_pid}"; then
            echo "[FATAL] Daemon process terminated unexpectedly. Check ${LOG_FILE}" >&2
            rm -f "${PID_FILE}"
            return 1
        fi
        if query_health; then
            echo "[OK] DockerSW daemon is ready at http://${HOST}:${PORT}"
            return 0
        fi
        sleep 1
        elapsed=$((elapsed + 1))
    done

    echo "[FATAL] Timed out waiting for daemon to become ready." >&2
    return 1
}

case "${COMMAND}" in
    start)
        do_start
        ;;
    stop)
        do_stop
        ;;
    restart)
        do_stop
        do_start
        ;;
    status)
        do_status
        ;;
    *)
        echo "Error: Unknown command '${COMMAND}'" >&2
        show_help >&2
        exit 1
        ;;
esac
