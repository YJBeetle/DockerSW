#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="/opt/sw-runtime/scripts/export_sw.py"
PYTHON_WIN="C:\\Python311\\python.exe"

# 若运行环境未初始化（如在 GitLab CI Docker Executor 下 entrypoint 被平台重写），自动拉起守护环境
if [ ! -S "/tmp/.X11-unix/X99" ] || [ ! -d "/root/.wine/drive_c/Program Files/SOLIDWORKS Corp/SOLIDWORKS" ]; then
    if [ -x "/usr/local/bin/entrypoint.sh" ]; then
        /usr/local/bin/entrypoint.sh --init-only >/dev/null 2>&1 || true
    fi
fi

# 若在非标准容器路径执行，回退到脚本所在相对目录
if [ ! -f "${SCRIPT_PATH}" ]; then
    LOCAL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [ -f "${LOCAL_DIR}/export_sw.py" ]; then
        SCRIPT_PATH="${LOCAL_DIR}/export_sw.py"
    fi
fi

# 转换为 Wine 识别的 Z:\... 路径
WIN_SCRIPT_PATH="Z:${SCRIPT_PATH}"
WIN_SCRIPT_PATH=$(echo "${WIN_SCRIPT_PATH}" | tr '/' '\\')

# 执行 Wine Windows Python 批处理
exec wine "${PYTHON_WIN}" "${WIN_SCRIPT_PATH}" "$@"
