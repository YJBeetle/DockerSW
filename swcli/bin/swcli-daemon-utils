#!/usr/bin/env bash
set -euo pipefail

# Internal host adapter: one action from the Python daemon manager, not CLI parsing.
action="${1:?daemon action required}"
shift
case "${action}" in
    start|serve|restart) set -- daemon "${action}" "$@" ;;
    doctor) set -- doctor "$@" ;;
    *) echo "Unsupported daemon utility action: ${action}" >&2; exit 2 ;;
esac
WIN_PYTHON="${SWCLI_WINDOWS_PYTHON:-C:\\Python311\\python.exe}"
SWCLI_SOURCE="${SWCLI_SOURCE:-/opt/swcli/src}"
SWCLI_DEPS="${SWCLI_DEPS:-/opt/swcli-deps}"
export SWCLI_HOST_PLATFORM="${SWCLI_HOST_PLATFORM:-linux-wine}"
export SWCLI_DAEMON_UTILS_ACTIVE=1
WINDOWS_SWCLI_SOURCE="$(winepath -w "${SWCLI_SOURCE}")"
WINDOWS_SWCLI_DEPS="$(winepath -w "${SWCLI_DEPS}/windows")"
exec env PYTHONPATH="${WINDOWS_SWCLI_SOURCE};${WINDOWS_SWCLI_DEPS}" \
    wine "${WIN_PYTHON}" -m swcli "$@"
