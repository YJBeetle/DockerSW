#!/usr/bin/env bash
set -euo pipefail

# Pure native client entrypoint. Python parses every public CLI option.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SWCLI_SOURCE="${SWCLI_SOURCE:-/opt/swcli/src}"
SWCLI_DEPS="${SWCLI_DEPS:-/opt/swcli-deps}"
export SWCLI_ENDPOINT="${SWCLI_ENDPOINT:-127.0.0.1:18495}"
export SWCLI_HOST_PLATFORM="${SWCLI_HOST_PLATFORM:-linux-wine}"
export SWCLI_DAEMON_UTILS="${SWCLI_DAEMON_UTILS:-${SCRIPT_DIR}/swcli-daemon-utils}"
export SWCLI_PATH_TRANSLATE_CMD=/usr/local/bin/linux-to-wine-path
exec env PYTHONPATH="${SWCLI_SOURCE}:${SWCLI_DEPS}/linux${PYTHONPATH:+:${PYTHONPATH}}" \
    python3 -m swcli "$@"
