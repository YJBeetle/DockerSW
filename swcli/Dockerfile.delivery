# DockerSW: 将同一个 SWCLI payload 链接到任意默认镜像
ARG IMAGE=sw-runtime:local
ARG PAYLOAD_IMAGE=swcli-payload:local

FROM ${PAYLOAD_IMAGE} AS swcli-payload
FROM ${IMAGE} AS swcli-delivery

COPY --link --from=swcli-payload / /
# Remove a superseded command if a caller supplies an older CLI-bearing base.
RUN rm -f /usr/local/bin/sw-cli

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/entrypoint.sh", "/usr/local/bin/entrypoint-cli.sh"]
CMD ["/bin/bash"]
