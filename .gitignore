# 系统临时文件
.DS_Store
Thumbs.db

# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# 运行时日志与输出
*.log
scratch/
dist/
dist_output/
*.tmp

# 严禁将任何 SolidWorks 专有商业二进制与授权文件提交至本公开仓库
SOLIDWORKS/
SolidWorks_Flexnet_Server/
*.lic
*.opt
*.exe
*.dll
*.msi
*.cab
*.iso
*.dmg

# 允许 scripts 目录下的代码与 shell 脚本
!scripts/*.py
!scripts/sw-export
